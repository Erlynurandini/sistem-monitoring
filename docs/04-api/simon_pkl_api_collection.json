{
  "info": {
    "name": "SIMON PKL API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Dokumentasi API resmi untuk Sistem Monitoring PKL (SIMON PKL) UKK RPL 2026"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login Guru / Siswa",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"guru@smkbudibakti.sch.id\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://127.0.0.1:8000/api/v1/login",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["api", "v1", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Presensi",
      "item": [
        {
          "name": "Get Presensi Siswa",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "http://127.0.0.1:8000/api/v1/presensi",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["api", "v1", "presensi"]
            }
          }
        },
        {
          "name": "Kirim Presensi Harian",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nisn\": \"0071234561\",\n  \"tanggal\": \"2026-03-30\",\n  \"status\": \"Hadir\",\n  \"jam_masuk\": \"07:30\"\n}"
            },
            "url": {
              "raw": "http://127.0.0.1:8000/api/v1/presensi",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["api", "v1", "presensi"]
            }
          }
        }
      ]
    },
    {
      "name": "Jurnal Kegiatan",
      "item": [
        {
          "name": "Get Daftar Jurnal",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "http://127.0.0.1:8000/api/v1/jurnal",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["api", "v1", "jurnal"]
            }
          }
        }
      ]
    }
  ]
}